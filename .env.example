# Copy this file to .env before using Docker Compose.
POSTGRES_DB=sushruta
POSTGRES_USER=sushruta
POSTGRES_PASSWORD=local-demo-only
DATABASE_URL=postgresql+psycopg://sushruta:local-demo-only@postgres:5432/sushruta

# Apollo (optional; leave blank to use the saved offline notes).
# TinyFish key: https://agent.tinyfish.ai/home  (server-side only, never put it in the app).
# One key covers Search, Fetch and the browser Agent.
TINYFISH_API_KEY=
