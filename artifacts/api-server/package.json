{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd ../.. && .pythonlibs/bin/alembic upgrade head && .pythonlibs/bin/uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8080}",
